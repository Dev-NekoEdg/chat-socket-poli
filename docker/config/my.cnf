# ==========================================
# Configuración de MySQL para Chat Socket Poli
# ==========================================

[mysqld]
# utf8mb4: soporta tildes, ñ y emojis en los mensajes.
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# Fechas de los mensajes en hora de Colombia.
default-time-zone    = -05:00

[client]
# Sin esto, el cliente mysql (incluido el que ejecuta los scripts de DDL/DML)
# se conecta en latin1 y las tildes/ñ se guardan mal.
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
