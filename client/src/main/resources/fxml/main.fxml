<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.poli.client.controller.MainController">

    <!-- Barra superior de sesión -->
    <top>
        <HBox
            alignment="CENTER_LEFT"
            spacing="15"
            style="-fx-background-color: #263238;"
            padding="12">

            <Label
                text="Chat Socket Poli"
                style="-fx-text-fill: white;
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;" />

            <Label
                fx:id="usernameLabel"
                text="Usuario:"
                style="-fx-text-fill: white;
                       -fx-font-size: 14px;" />

            <Button
                text="Cerrar sesión"
                onAction="#handleLogout"
                style="-fx-background-color: #d9534f;
                       -fx-text-fill: white;" />

        </HBox>
    </top>

    <!-- Contenedor de las vistas -->
    <center>
        <BorderPane
            fx:id="contentPane"
            style="-fx-background-color: #f4f6f8;">

            <center>
                <Label
                    text="Bienvenido al Chat Socket Poli"
                    style="-fx-font-size: 20px;" />
            </center>

        </BorderPane>
    </center>

</BorderPane>
