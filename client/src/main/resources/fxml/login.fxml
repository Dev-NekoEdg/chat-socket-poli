<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.poli.client.controller.LoginController"
      alignment="CENTER"
      spacing="15">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="CHAT SOCKET POLI" styleClass="title"/>

    <TextField fx:id="hostField"
               promptText="Dirección IP"
               text="127.0.0.1"/>

    <TextField fx:id="portField"
               promptText="Puerto"
               text="5000"/>

    <!-- Enter en el campo de usuario también conecta -->
    <TextField fx:id="usernameField"
               promptText="Nombre de usuario"
               onAction="#connectToServer"/>

    <Button fx:id="connectButton"
            text="Conectar"
            onAction="#connectToServer"
            defaultButton="true"
            styleClass="button-primary"
            maxWidth="Infinity"/>

    <Label fx:id="statusLabel"
           text="Desconectado"
           wrapText="true"
           styleClass="muted"/>

</VBox>
