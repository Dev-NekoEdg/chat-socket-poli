<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.poli.client.controller.NewChatRoomController"
      spacing="10">

    <padding>
        <Insets top="16" right="20" bottom="16" left="20"/>
    </padding>

    <Label text="Nuevo chatroom" styleClass="title"/>

    <!-- Nombre -->
    <Label text="Nombre" styleClass="field-label"/>
    <TextField fx:id="nameField" promptText="Ej: Proyecto final"/>

    <!-- Privado / público -->
    <CheckBox fx:id="privateCheck" text="Chatroom privado (si no se marca, es público)"/>

    <!-- Miembros -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Miembros" styleClass="field-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="selectedCountLabel" styleClass="muted"/>
    </HBox>
    <ListView fx:id="usersList" VBox.vgrow="ALWAYS"/>

    <Label fx:id="statusLabel" styleClass="status" wrapText="true"/>

    <!-- Acciones -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancelar" onAction="#handleCancel" cancelButton="true"/>
        <Button fx:id="createButton" text="Crear chatroom" onAction="#handleCreate" styleClass="button-primary"/>
    </HBox>

</VBox>
